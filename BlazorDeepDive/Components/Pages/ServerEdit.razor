@page "/servers/edit/{id:int}"

<h3>Server Edit</h3>
@Id

@if (server !=null)
{
    <EditForm Model="server" FormName="myForm" OnSubmit="SubmitMe">
        <InputText @bind-Value="server.Name"></InputText>
        <InputNumber @bind-Value="server.Id" hidden=""></InputNumber>
        <InputText @bind-Value="server.City"></InputText>
        <InputCheckbox @bind-Value="server.IsOnline"></InputCheckbox>
        <button class="btn btn-primary" type="submit">Submit</button>
        <a href="/servers/loop" class="btn btn-primary">Back</a>
    </EditForm>
}
else
{
    <p class="text-danger">
        @errorMessage
    </p>
}


@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm(FormName ="myForm")]
    private Server? server { get; set; }

    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (Id <= 0)
        {
            server = null;
            errorMessage = "Invalid server id.";
            return;
        }

        server ??= ServerRepository.GetServerById(Id);
        errorMessage = server is null ? $"Server with id {Id} was not found." : null;
    }



    private void SubmitMe()
    {
        if(server !=null)
        {
            ServerRepository.UpdateServer(server.Id, server);
        }
       
    }
}
