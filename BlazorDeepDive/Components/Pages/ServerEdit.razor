@page "/servers/edit/{id:int}"

<h3>Server Edit</h3>
@Id

@if (server !=null)
{
    <EditForm Model="server">
        <InputText @bind-Value="server.Name"></InputText>
        <InputNumber @bind-Value="server.Id"></InputNumber>
        <InputText @bind-Value="server.City"></InputText>
        <InputCheckbox @bind-Value="server.IsOnline"></InputCheckbox>
    </EditForm>
}
else
{
    <p class="text-danger">
        @errorMessage
    </p>
}
<a href="/servers/loop" class="btn btn-primary">Back</a>

@code {
    [Parameter]
    public int Id { get; set; }

    private Server? server;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (Id <= 0)
        {
            server = null;
            errorMessage = "Invalid server id.";
            return;
        }

        server = ServerRepository.GetServerById(Id);
        errorMessage = server is null ? $"Server with id {Id} was not found." : null;
    }
}
