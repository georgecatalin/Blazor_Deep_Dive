@page "/servers/loop"
@inject NavigationManager navigationManager

<h3>ServerLoop</h3>
<p>
    <ul>
          @foreach (var server in servers)
    {
        <li>
            @server.Name from @server.City is 
            <span style="color:@(server.IsOnline ? "green" : "red")">
             @(server.IsOnline ? "online" : "offline")
            </span>
            &nbsp;
            <a href="/servers/edit/@server.Id" class="btn btn-link">Edit</a>
            <EditForm Model="server" FormName=@($"form-delete-{server.Id}") OnValidSubmit="() => DeleteServer(server.Id)">
                <button type="submit" class="btn btn-warning">Delete</button>
            </EditForm>
            </li>
    }
    </ul>
    
        <ComponentServer @rendermode="InteractiveServer"></ComponentServer>
    
    <p><a href="/servers/add" class="btn btn-link">Add</a></p>
</p>



@code {
    private List<Server> servers = ServerRepository.GetServersByCity("Toronto");

    private void DeleteServer(int id)
    {
        if(id > 0)
        {
            ServerRepository.DeleteServer(id);
            navigationManager.Refresh();
        }
    }
}
