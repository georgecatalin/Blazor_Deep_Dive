@page "/servers/loop"
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<h3>ServerLoop</h3>
<p>
    <ul>
        @foreach (var server in servers)
        {
             <ComponentServer Server="server" SelectedCity="@selectedCity" @rendermode="InteractiveServer" />
            <button type="button" class="btn btn-primary mb-3" @onclick="() => SelectCity(server)">Select the City</button> 
        }
    </ul>
    @selectedCity


    <p><a href="/servers/add" class="btn btn-link">Add</a></p>
</p>



@code {
    private List<Server> servers = ServerRepository.GetServersByCity("Toronto");

    private string selectedCity = "Toronto";

    private void DeleteServer(int id)
    {
        if (id > 0)
        {
            ServerRepository.DeleteServer(id);
            navigationManager.Refresh();
        }
    }

    private void SelectCity(Server server)
    {
        if (!string.IsNullOrWhiteSpace(server.City))
        {
            this.selectedCity = server.City;
        }
    }

}
