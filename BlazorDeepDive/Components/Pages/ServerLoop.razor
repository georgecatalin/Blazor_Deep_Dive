@page "/servers/loop"

<h3>ServerLoop</h3>
<p>
    <ul>
          @foreach (var server in servers)
    {
        <li>
            @server.Name from @server.City is 
            <span style="color:@(server.IsOnline ? "green" : "red")">
             @(server.IsOnline ? "online" : "offline")
            </span>
            &nbsp;
            <a href="/servers/edit/@server.Id" class="btn btn-link">Edit</a>
        </li>
    }
    </ul>
    <p><a href="/servers/add" class="btn btn-link">Add</a></p>
</p>



    @code {
        private List<Server> servers = ServerRepository.GetServersByCity("Toronto");
}
