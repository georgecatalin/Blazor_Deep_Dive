@page "/servers"
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<h3>Servers</h3>
<br/>
<br/>
<div class="container-fluid text-center">
    <div class="row w-50">
        @foreach (var city in cities)
        {
            <div class="col">
                <div class="card @(selectedCity.Equals(city,StringComparison.OrdinalIgnoreCase) ? "border-primary" : "") ">
                    <img class="card-img-top" src="@($"/images/{city}.png")" />
                    <div class="card-body">
                        <button type="button" class="btn btn-primary" @onclick="@(() => {SelectCity(city);})">Select</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<br/>
 <div class="input-group mb-3">
     <input type="text" class="form-control" @bind-value="serverFilter" placeholder="Search Servers" />
     <button type="button" class="btn btn-outline-secondary" id="btn-search" @onclick="HandleFilter">Search</button>
 </div>
<br/>

<ul>
    @foreach (var server in servers)
    {
        <li>
            @server.Name is located in @server.City with the status
            <span style="@($"color:{(  server.IsOnline? "green" : "red")}")">
                @(server.IsOnline ? "Online" : "Offline")
            </span>
            &nbsp;
            <a href="/servers/edit/@server.Id" class="btn btn-link">Edit</a>
            &nbsp;
            <EditForm Model="server" FormName="@($"form-server-{server.Id}")" OnValidSubmit="@(()=>{ DeleteServer(server.Id);})">
                <button type="submit" class="btn btn-primary">Delete</button>
            </EditForm>
        </li>
    }
</ul>
<p>
    <a href="/servers/add" class="btn btn-primary">Add Server</a>
</p>


@code {
    private List<Server> servers = ServerRepository.GetServersByCity("Toronto");
    private List<string> cities = CitiesRepository.GetCities();
    private string selectedCity = "Toronto";

    private string? _serverFilter;
    private string serverFilter { get =>_serverFilter??string.Empty; 
        set
        {
            _serverFilter = value;
            //capture the value and do logic
            this.servers = ServerRepository.SearchServers(serverFilter);
            this.selectedCity = string.Empty;
        }
    }

    private void DeleteServer(int id)
    {
        if(id > 0)
        {
            ServerRepository.DeleteServer(id);
            navigationManager.Refresh();
        }
    }

    private void SelectCity(string city)
    {
        this.selectedCity = city;
        this.servers = ServerRepository.GetServersByCity(selectedCity);
    }


    private void HandleFilter()
    {
        this.servers = ServerRepository.SearchServers(serverFilter);
        this.selectedCity = string.Empty;
    }
}
