<h3>ComponentServer</h3>




@if(server !=null)
{
    <div style="@($"color:{(server.IsOnline ? "green" : "red")}")">
        Server-side Blazor component that provides a server-side rendering environment for Blazor components.
        @serverInfo published at @DateTime.Now
        @server.Name -> @server.City
        <br />
        Server is @(server.IsOnline ? "online" : "offline")
    </div>

        <button type="button" class="btn btn-primary" @onclick="ChangeMe">Turn On/Off</button>

}




@code {
    private string serverInfo = "The information";


    public Server? server { get; set; } = new Server() { Name = "Server Alpha", City = "Toronto" };

    private void ChangeMe()
    {
        if(server != null)
        {
            this.server.IsOnline = !this.server.IsOnline;
        }
    }

}
