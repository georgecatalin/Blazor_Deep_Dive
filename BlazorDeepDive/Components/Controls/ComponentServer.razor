<h3>ComponentServer</h3>

<p style="@($"color:{(serverDetails.IsOnline ? "green" : "red")}")">
    Server-side Blazor component that provides a server-side rendering environment for Blazor components.
    @serverInfo published at @DateTime.Now
   <br/>
    Server is @(serverDetails.IsOnline  ? "online" : "offline")
</p>

<div class="alert alert-info" data-name="@(serverDetails.IsOnline ? "online" : "offline")" style="color:@(serverDetails.IsOnline ? "green" : "red")">
    <p>
        Server Details: <br />
Id =@serverDetails.Id,<br/>
Name = @serverDetails.Name, <br/>
City = @serverDetails.City <br/>
    </p>    
</div>

@code {
    private string serverInfo = "Server-side Blazor component is running.";
    private Server serverDetails = new Server
        {
            Id = 2324,
            Name = "Blazor Server",
            City = "Galati"
        };
}
