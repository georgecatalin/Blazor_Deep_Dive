@if(Server is not null)
{
    <div data-name="@Server.Name" data-status="Server is @(Server.IsOnline ? "online" : "offline")" 
    style="@($"color : {(Server.IsOnline ? "green" : "red")}")" >
    @Server.Name is located in @Server.City and its status is -> @(Server.IsOnline ? "online" : "offline")
    <button type="button" class="btn btn-primary" @onclick="SwitchStatus">Toggle the Server Status</button>

    </div>
}


@code
{
    private Server? Server { get; set; } = new Server() { Name = "Server 1", City = "Toronto" };

    private void SwitchStatus()
    {
        if(Server is not null)
        {
            this.Server.IsOnline = !this.Server.IsOnline;
        }
    }
}