@inject NavigationManager navigationManager

@if(Server is not null)
{
    <li @key="@Server.Id">
        @Server.Name is located in @Server.City with the status
        <span style="@($"color:{(Server.IsOnline ? "green" : "red")}")">
            @(Server.IsOnline ? "Online" : "Offline")
        </span>
        &nbsp;
        <a href="/servers/edit/@Server.Id" class="btn btn-link">Edit</a>
        &nbsp;
        <EditForm Model="Server" FormName="@($"form-server-{Server.Id}")" OnValidSubmit="@(() => DeleteServer(Server.Id))">
            <button type="submit" class="btn btn-primary">Delete</button>
        </EditForm>
    </li>
}


@code
{
    [Parameter]
    public Server? Server { get; set; } 


    private void DeleteServer(int id)
    {
        if (id > 0)
        {
            ServerRepository.DeleteServer(id);
            navigationManager.NavigateTo("/servers", true);
        }
    }
}